### environment modules ###

export MODULEPATH="$(dirname "${BASH_SOURCE[0]}")"/../environmental-modules/profile

module() {
    eval "$(modulecmd sh "$@")"
}

load_modules() {
	if ! command -v module >/dev/null 2>&1; then
		return
	fi

	local modules=(
        apache-ant
        apache-tomcat
        gcc
        jdk
    )

	printf '# Loading module %s\n' "${modules[@]}"

	local module_name

    for module_name in "${modules[@]}"; do
        module unload "$module_name" >/dev/null 2>&1 || true
        module load "$module_name"
    done
}

print_profile_path
load_modules
unset -f load_modules
