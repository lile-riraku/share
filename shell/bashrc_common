setup() {
	local file_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

	### Prompt ###
	PS1='[\h:\W] '
	PROMPT_COMMAND="set_terminal_title${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

	### Alias ###
	alias cdw='cd $WORK'
	alias beep="osascript -e 'beep'"
	alias ll='ls -l --color=always'
	alias lh='ll | head -n '
	alias grep='grep --color=always'
	alias gita='git add '
	alias gitb='git branch '
	alias gitc='git checkout '
	alias gitcm='git commit '
	alias gitcp='git cherry-pick '
	alias gitd='git diff '
	alias gitf='git fetch '
	alias gitl='git log '
	alias gitm='git merge '
	alias gitp='git pull '
	alias gitr='git reset '
	alias gitrb='git rebase '
	alias gits='git status '
	alias python='python3'

	### Dependency ###
	for bin_dir in "$HOME"/.local/bin*; do
		[[ -d "$bin_dir" ]] || continue
		case ":$PATH:" in
			*":$bin_dir:"*) ;;
			*) PATH="$bin_dir:$PATH" ;;
		esac
	done
	unset bin_dir
	export INCLUDE=$INSTALL/include:$INCLUDE
	export C_INCLUDE_PATH=$INSTALL/include:$C_INCLUDE_PATH
	export CXX_INCLUDE_PATH=$INSTALL/include:$CXX_INCLUDE_PATH
	export LIBRARY_PATH=$INSTALL/lib:$LIBRARY_PATH
	export LD_LIBRARY_PATH=$INSTALL/lib:$LD_LIBRARY_PATH
	export CLASSPATH=$INSTALL/lib:$CLASSPATH

	### Default ###
	export EDITOR=emacs
	export CC=gcc
	export CXX=g++

	### setup ###
	ssh-add -k > /dev/null 2>&1
	local ssh_add_status=$?
	if (( ssh_add_status == 2 )); then
		eval "$(ssh-agent -s)" >/dev/null
	fi
	export HOMEBREW_PREFIX=/opt/homebrew
}

set_terminal_title() {
    local shell_name

    if [[ -n "${ZSH_VERSION:-}" ]]; then
        shell_name="zsh"
    elif [[ -n "${BASH_VERSION:-}" ]]; then
        shell_name="bash"
    else
        shell_name="${SHELL##*/}"
    fi

    printf '\033]0;%s\007' "$shell_name"
}

print_profile_path
setup
unset -f setup
