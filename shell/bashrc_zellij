show_zellij_title() {
    if [[ -n "$ZELLIJ" ]]; then
        local session="${ZELLIJ_SESSION_NAME:-zellij}"
        printf '\033]2;[%s] %s\007' "$session" "$PWD"

        if [[ -n "$ZELLIJ_SESSION_NAME" ]]; then
            mkdir -p "$HOME/.cache/zellij-pwd"
            printf '%s' "$PWD" > "$HOME/.cache/zellij-pwd/$ZELLIJ_SESSION_NAME"
        fi
    fi
}

za() {
    local session="$1"
    local file="$HOME/.cache/zellij-pwd/$session"

    if [[ -f "$file" ]]; then
        local pwd
        pwd="$(cat "$file")"
        printf '\033]2;[%s] %s\007' "$session" "$pwd"
    else
        printf '\033]2;[%s]\007' "$session"
    fi

    zellij attach "$session"
}

